---
import BaseLayout from "./BaseLayout.astro";
import AuthorBox from "../components/AuthorBox.astro";

interface Reference {
  title: string;
  organization?: string;
  url: string;
}

interface Props {
  title: string;
  description: string;
  publishedAt: Date;
  updatedAt?: Date;
  category: string;
  readingTime: number;
  image?: string;
  imageAlt?: string;
  references?: Reference[];
}

const {
  title,
  description,
  publishedAt,
  updatedAt,
  category,
  readingTime,
  image,
  imageAlt,
  references = []
} = Astro.props;

const dateFormatter = new Intl.DateTimeFormat("es-CO", {
  day: "numeric",
  month: "long",
  year: "numeric"
});

const siteURL =
  Astro.site ?? new URL("https://purevitalpro.online");

const canonicalURL = new URL(Astro.url.pathname, siteURL);

const structuredData = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: title,
  description,
  datePublished: publishedAt.toISOString(),
  dateModified: (
    updatedAt ?? publishedAt
  ).toISOString(),
  mainEntityOfPage: canonicalURL.toString(),
  inLanguage: "es-CO",
  author: {
    "@type": "Person",
    name: "Darwin Candelo"
  },
  publisher: {
    "@type": "Organization",
    name: "Pure Vital Pro",
    url: siteURL.toString()
  },
  ...(image && {
    image: new URL(image, siteURL).toString()
  })
};
---

<BaseLayout
  title={title}
  description={description}
  image={image}
    type="article"
  publishedAt={publishedAt}
  updatedAt={updatedAt}
>
  <Fragment slot="head">
    <script
      type="application/ld+json"
      set:html={JSON.stringify(structuredData)}
    />
  </Fragment>

  <article class="article">
    <header class="article-header">
      <div class="content-container">
        <a
          class="article-header__category"
          href={`/articulos?categoria=${encodeURIComponent(category)}`}
        >
          {category}
        </a>

        <h1>{title}</h1>

        <p class="article-header__description">
          {description}
        </p>

        <div class="article-header__meta">
          <span>
            Publicado el
            <time datetime={publishedAt.toISOString()}>
              {dateFormatter.format(publishedAt)}
            </time>
          </span>

          <span aria-hidden="true">•</span>

          <span>{readingTime} min de lectura</span>

          {
            updatedAt && (
              <>
                <span aria-hidden="true">•</span>

                <span>
                  Actualizado el
                  <time datetime={updatedAt.toISOString()}>
                    {dateFormatter.format(updatedAt)}
                  </time>
                </span>
              </>
            )
          }
        </div>
      </div>
    </header>

    {
      image && (
        <div class="container article-image">
          <img
            src={image}
            alt={imageAlt ?? ""}
            width="1200"
            height="675"
            loading="eager"
            decoding="async"
          />
        </div>
      )
    }

    <div class="content-container article-body">
      <div class="article-disclaimer">
        <strong>En pocas palabras:</strong>

        <p>
          Este contenido es educativo y general. No sustituye
          una valoración ni una recomendación profesional
          adaptada a tu condición particular.
        </p>
      </div>

      <div class="article-content">
        <slot />
        </div>
        
<AuthorBox reviewedAt={updatedAt ?? publishedAt} />
      
      {
        references.length > 0 && (
          <section
            class="references"
            aria-labelledby="references-title"
          >
            <h2 id="references-title">
              Fuentes y referencias
            </h2>

            <ol>
              {
                references.map((reference) => (
                  <li>
                    <a href={reference.url}>
                      target="_blank"
                      rel="noopener noreferrer"
                      >
                      {reference.title}
                    </a>

                    {
                      reference.organization && (
                        <span>
                          {" "}
                          — {reference.organization}
                        </span>
                      )
                    }
                  </li>
                ))
              }
            </ol>
          </section>
        )
      }

      <aside class="article-cta">
        <p class="article-cta__eyebrow">
          Una idea práctica para comenzar
        </p>

        <h2>Elimina una barrera antes de añadir otra rutina</h2>

        <p>
          Descarga gratis La Vía Negativa 40+, una
          infografía diseñada para leer desde el teléfono.
        </p>

        <a
          class="button"
          href="/empieza-aqui"
        >
          Quiero la infografía
        </a>
      </aside>
    </div>
  </article>
</BaseLayout>

<style>
  .article {
    background: var(--color-paper);
  }

  /* Encabezado */

  .article-header {
    padding-block: var(--space-16) var(--space-12);
    background:
      radial-gradient(
        circle at 85% 10%,
        rgb(138 175 194 / 20%),
        transparent 30rem
      ),
      var(--color-sand);
  }

  .article-header__category {
    display: inline-flex;
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-pill);
    background: rgb(82 122 90 / 13%);
    color: var(--color-forest-dark);
    font-size: var(--text-xs);
    font-weight: var(--weight-extrabold);
    letter-spacing: 0.1em;
    text-decoration: none;
    text-transform: uppercase;
  }

  .article-header h1 {
    margin-top: var(--space-6);
    font-size: clamp(2.75rem, 7vw, 4.75rem);
    letter-spacing: -0.045em;
  }

  .article-header__description {
    max-width: 44rem;
    margin-top: var(--space-6);
    color: var(--color-text-muted);
    font-size: clamp(
      var(--text-lg),
      2vw,
      var(--text-xl)
    );
  }

  .article-header__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-6);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .article-header__meta time {
    margin-left: var(--space-1);
  }

  /* Imagen */

  .article-image {
    padding-top: var(--space-10);
  }

  .article-image img {
    width: 100%;
    max-height: 42rem;
    object-fit: cover;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
  }

  /* Cuerpo */

  .article-body {
    padding-block: var(--space-12) var(--space-20);
  }

  .article-disclaimer {
    margin-bottom: var(--space-10);
    padding: var(--space-5);
    border-left: 0.3rem solid var(--color-mustard);
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
    background: var(--color-sand);
  }

  .article-disclaimer strong {
    color: var(--color-forest-dark);
  }

  .article-disclaimer p {
    margin-top: var(--space-2);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  /* Los :global son necesarios porque el contenido
     Markdown se renderiza dentro del slot. */

  .article-content :global(h2) {
    margin-top: var(--space-12);
    font-size: clamp(
      var(--text-2xl),
      5vw,
      var(--text-3xl)
    );
  }

  .article-content :global(h3) {
    margin-top: var(--space-8);
    font-size: var(--text-2xl);
  }

  .article-content :global(p) {
    margin-top: var(--space-5);
    color: #33443f;
    font-size: var(--text-lg);
    line-height: 1.8;
  }

  .article-content :global(ul),
  .article-content :global(ol) {
    display: grid;
    gap: var(--space-3);
    margin-top: var(--space-5);
    padding-left: var(--space-6);
    color: #33443f;
    font-size: var(--text-lg);
  }

  .article-content :global(li) {
    padding-left: var(--space-2);
  }

  .article-content :global(strong) {
    color: var(--color-ink);
  }

  .article-content :global(a) {
    color: var(--color-forest-dark);
    font-weight: var(--weight-semibold);
    text-decoration-color: var(--color-mustard);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.25rem;
  }

  .article-content :global(blockquote) {
    margin: var(--space-8) 0;
    padding: var(--space-6);
    border-radius: var(--radius-md);
    background: #e9eee7;
    color: var(--color-forest-dark);
    font-family: var(--font-display);
    font-size: var(--text-xl);
  }

  /* Referencias */

  .references {
    margin-top: var(--space-16);
    padding-top: var(--space-8);
    border-top: 1px solid var(--color-border);
  }

  .references h2 {
    font-size: var(--text-3xl);
  }

  .references ol {
    display: grid;
    gap: var(--space-4);
    margin-top: var(--space-6);
    padding-left: var(--space-6);
  }

  .references li {
    padding-left: var(--space-2);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .references a {
    color: var(--color-forest-dark);
    font-weight: var(--weight-semibold);
    text-underline-offset: 0.25rem;
  }

  /* CTA final */

  .article-cta {
    margin-top: var(--space-16);
    padding: var(--space-8);
    border-radius: var(--radius-lg);
    background: var(--color-forest);
    color: var(--color-white);
  }

  .article-cta__eyebrow {
    color: var(--color-mustard);
    font-size: var(--text-xs);
    font-weight: var(--weight-extrabold);
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }

  .article-cta h2 {
    margin-top: var(--space-3);
    font-size: clamp(
      var(--text-2xl),
      5vw,
      var(--text-3xl)
    );
  }

  .article-cta > p:not(.article-cta__eyebrow) {
    margin-top: var(--space-4);
    color: #e7eee8;
  }

  .article-cta .button {
    margin-top: var(--space-6);
  }

  @media (min-width: 48rem) {
    .article-header {
      padding-block: var(--space-20) var(--space-16);
    }

    .article-body {
      padding-top: var(--space-16);
    }

    .article-cta {
      padding: var(--space-10);
    }
  }
</style>