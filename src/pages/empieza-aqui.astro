---
import BaseLayout from "../layouts/BaseLayout.astro";
import NewsletterForm from "../components/NewsletterForm.astro";

const benefits = [
  {
    number: "01",
    title: "Identifica una barrera",
    description:
      "Reconoce qué está dificultando que el movimiento forme parte de tu vida cotidiana."
  },
  {
    number: "02",
    title: "Elimina una complicación",
    description:
      "Simplifica el entorno antes de añadir nuevas rutinas, aplicaciones o exigencias."
  },
  {
    number: "03",
    title: "Prueba durante siete días",
    description:
      "Observa qué sucede cuando concentras tu atención en quitar un solo obstáculo."
  }
];
---

<BaseLayout
  title="Empieza aquí"
  description="Descarga gratis La Vía Negativa 40+, una infografía práctica para eliminar las barreras que dificultan el movimiento después de los 40."
  image="/images/guias/via-negativa-40.png"
>
  <section class="lead-hero">
    <div class="container lead-hero__grid">
      <div class="lead-hero__content">
        <p class="eyebrow">
          Recurso gratuito
        </p>

        <h1>
          Empieza quitando lo que está frenando tu movimiento
        </h1>

        <p class="lead-hero__description">
          Descarga gratis
          <strong>La Vía Negativa 40+</strong>,
          una infografía práctica para identificar y
          eliminar una de las barreras que dificultan
          que te muevas con regularidad.
        </p>

        <ul class="lead-hero__points">
          <li>
            <span aria-hidden="true">✓</span>
            Diseñada para leer cómodamente desde el teléfono.
          </li>

          <li>
            <span aria-hidden="true">✓</span>
            Una idea clara que puedes aplicar durante siete días.
          </li>

          <li>
            <span aria-hidden="true">✓</span>
            Sin rutinas extremas ni promesas rápidas.
          </li>
        </ul>

        <div class="lead-hero__form">
          <NewsletterForm />
        </div>

        <p class="lead-hero__privacy">
          Recibirás la infografía y los correos de
          Vital 40+. Puedes darte de baja cuando quieras.
        </p>
      </div>

      <div class="lead-hero__preview">
        <div class="lead-hero__image-frame">
          <img
            src="/images/guias/via-negativa-40.png"
            alt="Vista previa de la infografía La Vía Negativa 40+"
            width="1080"
            height="1920"
            loading="eager"
          />
        </div>

        <p>
          Formato vertical optimizado para dispositivos móviles.
        </p>
      </div>
    </div>
  </section>

  <section class="how-it-works section">
    <div class="container">
      <div class="how-it-works__heading">
        <p class="how-it-works__eyebrow">
          Una aplicación sencilla
        </p>

        <h2 class="section-title">
          No necesitas cambiarlo todo
        </h2>

        <p class="section-description">
          La propuesta consiste en reducir una dificultad
          concreta antes de intentar incorporar más tareas
          a tu día.
        </p>
      </div>

      <div class="how-it-works__grid">
        {
          benefits.map((benefit) => (
            <article class="benefit">
              <span class="benefit__number">
                {benefit.number}
              </span>

              <h3>{benefit.title}</h3>

              <p>{benefit.description}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="after-signup">
    <div class="container after-signup__inner">
      <div>
        <p class="after-signup__eyebrow">
          Después de registrarte
        </p>

        <h2>Revisa tu correo electrónico</h2>
      </div>

      <div class="after-signup__steps">
        <p>
          <strong>1.</strong>
          Recibirás un mensaje para confirmar tu dirección.
        </p>

        <p>
          <strong>2.</strong>
          Pulsa el botón “Confirmar y descargar”.
        </p>

        <p>
          <strong>3.</strong>
          La infografía se abrirá o descargará automáticamente.
        </p>
      </div>
    </div>
  </section>

  <section class="educational-note">
    <div class="content-container">
      <h2>Información para comprender y actuar mejor</h2>

      <p>
        Pure Vital Pro comparte contenidos educativos sobre
        fuerza, movimiento, descanso, nutrición general y
        bienestar después de los 40.
      </p>

      <p>
        Esta información no sustituye una valoración,
        diagnóstico, tratamiento o recomendación profesional
        adaptada a tu situación particular.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  /* Sección principal */

  .lead-hero {
    padding-block: var(--space-12) var(--space-16);
    overflow: hidden;
    background:
      radial-gradient(
        circle at 85% 15%,
        rgb(138 175 194 / 24%),
        transparent 32rem
      ),
      var(--color-sand);
  }

  .lead-hero__grid {
    display: grid;
    gap: var(--space-12);
  }

  .lead-hero__content {
    align-self: center;
  }

  .lead-hero h1 {
    max-width: 48rem;
    margin-top: var(--space-6);
    font-size: clamp(2.8rem, 7vw, 5rem);
    letter-spacing: -0.045em;
  }

  .lead-hero__description {
    max-width: 43rem;
    margin-top: var(--space-6);
    color: var(--color-text-muted);
    font-size: clamp(
      var(--text-lg),
      2vw,
      var(--text-xl)
    );
  }

  .lead-hero__description strong {
    color: var(--color-forest-dark);
  }

  .lead-hero__points {
    display: grid;
    gap: var(--space-3);
    margin-top: var(--space-8);
    list-style: none;
  }

  .lead-hero__points li {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
  }

  .lead-hero__points span {
    color: var(--color-forest);
    font-size: var(--text-lg);
    line-height: 1.3;
  }

  .lead-hero__form {
    max-width: 45rem;
    margin-top: var(--space-8);
  }

  .lead-hero__privacy {
    max-width: 42rem;
    margin-top: var(--space-3);
    color: var(--color-text-muted);
    font-size: var(--text-xs);
  }

  /* Vista previa */

  .lead-hero__preview {
    display: grid;
    align-content: center;
    justify-items: center;
    gap: var(--space-4);
  }

  .lead-hero__image-frame {
    position: relative;
    width: min(100%, 22rem);
    padding: var(--space-3);
    border: 1px solid var(--color-border-light);
    border-radius: var(--radius-lg);
    background: var(--color-ivory);
    box-shadow: var(--shadow-lg);
    transform: rotate(1.5deg);
  }

  .lead-hero__image-frame::before {
    position: absolute;
    z-index: -1;
    inset: 1.5rem -1rem -1rem 1.5rem;
    border-radius: var(--radius-lg);
    background: var(--color-clay);
    content: "";
    opacity: 0.2;
  }

  .lead-hero__image-frame img {
    width: 100%;
    border-radius: calc(var(--radius-lg) - 0.5rem);
  }

  .lead-hero__preview > p {
    max-width: 20rem;
    color: var(--color-text-muted);
    font-size: var(--text-xs);
    text-align: center;
  }

  /* Funcionamiento */

  .how-it-works {
    background: var(--color-paper);
  }

  .how-it-works__heading {
    max-width: 48rem;
  }

  .how-it-works__eyebrow,
  .after-signup__eyebrow {
    margin-bottom: var(--space-3);
    color: var(--color-forest);
    font-size: var(--text-xs);
    font-weight: var(--weight-extrabold);
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }

  .how-it-works__grid {
    display: grid;
    gap: var(--space-5);
    margin-top: var(--space-10);
  }

  .benefit {
    padding: var(--space-6);
    border: 1px solid var(--color-border-light);
    border-radius: var(--radius-md);
    background: var(--color-ivory);
  }

  .benefit__number {
    display: inline-grid;
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
    background: var(--color-forest);
    color: var(--color-white);
    font-size: var(--text-sm);
    font-weight: var(--weight-extrabold);
    place-items: center;
  }

  .benefit h3 {
    margin-top: var(--space-5);
    font-size: var(--text-2xl);
  }

  .benefit p {
    margin-top: var(--space-3);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  /* Después del registro */

  .after-signup {
    padding-block: var(--space-16);
    background: #e8dfcf;
  }

  .after-signup__inner {
    display: grid;
    gap: var(--space-8);
  }

  .after-signup h2 {
    max-width: 30rem;
    font-size: clamp(
      var(--text-3xl),
      5vw,
      var(--text-4xl)
    );
  }

  .after-signup__steps {
    display: grid;
    gap: var(--space-4);
  }

  .after-signup__steps p {
    padding: var(--space-5);
    border-radius: var(--radius-sm);
    background: rgb(255 253 248 / 65%);
    color: var(--color-text-muted);
  }

  .after-signup__steps strong {
    margin-right: var(--space-2);
    color: var(--color-clay-dark);
  }

  /* Nota educativa */

  .educational-note {
    padding-block: var(--space-12);
    background: var(--color-forest);
    color: var(--color-white);
    text-align: center;
  }

  .educational-note h2 {
    font-size: var(--text-3xl);
  }

  .educational-note p {
    margin-top: var(--space-4);
    color: #e7eee8;
  }

  /* Responsive */

  @media (min-width: 48rem) {
    .how-it-works__grid {
      grid-template-columns: repeat(3, 1fr);
    }

    .after-signup__inner {
      grid-template-columns: 0.8fr 1.2fr;
      align-items: start;
    }
  }

  @media (min-width: 64rem) {
    .lead-hero {
      padding-block: var(--space-20);
    }

    .lead-hero__grid {
      grid-template-columns: minmax(0, 1.3fr) minmax(18rem, 0.7fr);
      align-items: center;
    }
  }

  @media (max-width: 40rem) {
    .lead-hero__preview {
      grid-row: 1;
    }

    .lead-hero__image-frame {
      width: min(80%, 18rem);
    }
  }
</style>