---
import Brand from "./Brand.astro";

const currentYear = new Date().getFullYear();

const exploreLinks = [
  {
    href: "/",
    label: "Inicio",
  },
  {
    href: "/empieza-aqui",
    label: "Empieza aquí",
  },
  {
    href: "/articulos",
    label: "Artículos",
  },
];

const informationLinks = [
  {
    href: "/criterio-editorial",
    label: "Criterio editorial",
  },
  {
    href: "/aviso-educativo",
    label: "Aviso educativo",
  },
  {
    href: "/privacidad",
    label: "Privacidad",
  },
];
---

<footer class="site-footer">
  <div class="container site-footer__grid">
    <div class="site-footer__intro">
      <Brand compact light />

      <p>
        Ideas basadas en evidencia para conservar fuerza,
        movimiento y vitalidad después de los 40.
      </p>
    </div>

    <nav
      class="site-footer__navigation"
      aria-labelledby="footer-explora"
    >
      <h2 id="footer-explora">Explora</h2>

      {
        exploreLinks.map((item) => (
          <a href={item.href}>
            {item.label}
          </a>
        ))
      }
    </nav>

    <nav
      class="site-footer__navigation"
      aria-labelledby="footer-informacion"
    >
      <h2 id="footer-informacion">Información</h2>

      {
        informationLinks.map((item) => (
          <a href={item.href}>
            {item.label}
          </a>
        ))
      }
    </nav>
  </div>

  <div class="container site-footer__bottom">
    <p>
      © {currentYear} Pure Vital Pro.
    </p>

    <p>
      Contenido educativo. No sustituye la orientación
      profesional individual.
    </p>
  </div>
</footer>

<style>
  .site-footer {
    padding: var(--space-16) 0 var(--space-6);
    background: var(--color-ink);
    color: var(--color-ivory);
  }

  .site-footer__grid {
    display: grid;
    gap: var(--space-10);
  }

  .site-footer__intro p {
    max-width: 32rem;
    margin-top: var(--space-5);
    color: var(--color-text-light);
    font-size: var(--text-sm);
    line-height: 1.7;
  }

  .site-footer__navigation {
    align-content: start;
  }

  .site-footer__navigation h2 {
    margin: 0 0 var(--space-4);
    color: var(--color-mustard);
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: var(--weight-extrabold);
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }

  .site-footer__navigation a {
    display: block;
    width: fit-content;
    margin-block: var(--space-3);
    color: #e6e8e7;
    font-size: var(--text-sm);
    text-decoration: none;
    text-underline-offset: 0.3rem;
  }

  .site-footer__navigation a:hover {
    color: var(--color-white);
    text-decoration: underline;
    text-decoration-color: var(--color-clay);
    text-decoration-thickness: 2px;
  }

  .site-footer__navigation a:focus-visible {
    color: var(--color-white);
    outline: 2px solid var(--color-mustard);
    outline-offset: 0.3rem;
    border-radius: 0.15rem;
  }

  .site-footer__bottom {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin-top: var(--space-12);
    padding-top: var(--space-5);
    border-top: 1px solid rgb(255 255 255 / 13%);
    color: #aeb9ba;
    font-size: var(--text-xs);
  }

  .site-footer__bottom p {
    margin: 0;
  }

  @media (min-width: 48rem) {
    .site-footer {
      padding-top: var(--space-20);
    }

    .site-footer__grid {
      grid-template-columns: minmax(20rem, 1.6fr) 1fr 1fr;
    }

    .site-footer__bottom {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }
</style>