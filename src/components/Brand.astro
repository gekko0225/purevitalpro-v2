---
interface Props {
  compact?: boolean;
  light?: boolean;
}

const {
  compact = false,
  light = false
} = Astro.props;
---

<a
  class:list={[
    "brand",
    {
      "brand--compact": compact,
      "brand--light": light
    }
  ]}
  href="/"
  aria-label="Pure Vital Pro, página de inicio"
>
  <span class="brand__mark" aria-hidden="true">
    <span class="brand__accent"></span>
  </span>

  <span class="brand__text">
    <strong>Pure Vital Pro</strong>
    <small>Vital 40+</small>
  </span>
</a>

<style>
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.8rem;
    width: fit-content;
    color: var(--color-ink);
    text-decoration: none;
  }

  .brand__mark {
    position: relative;
    width: 2.45rem;
    height: 2.45rem;
    flex: 0 0 auto;
    border: 3px solid var(--color-forest);
    border-radius: 50%;
  }

  .brand__accent {
    position: absolute;
    top: -0.35rem;
    right: -0.3rem;
    width: 0.95rem;
    height: 0.95rem;
    border-radius: 50%;
    background: var(--color-mustard);
  }

  .brand__text {
    display: grid;
    gap: 0.3rem;
  }

  .brand strong {
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: var(--weight-bold);
    line-height: 1;
  }

  .brand small {
    color: var(--color-forest);
    font-size: 0.62rem;
    font-weight: var(--weight-extrabold);
    letter-spacing: 0.2em;
    line-height: 1;
    text-transform: uppercase;
  }

  .brand--compact {
    gap: 0.65rem;
  }

  .brand--compact .brand__mark {
    width: 2rem;
    height: 2rem;
    border-width: 2px;
  }

  .brand--compact .brand__accent {
    top: -0.25rem;
    right: -0.2rem;
    width: 0.75rem;
    height: 0.75rem;
  }

  .brand--compact strong {
    font-size: 1.15rem;
  }

  .brand--light {
    color: var(--color-ivory);
  }

  .brand--light .brand__mark {
    border-color: var(--color-ivory);
  }

  .brand--light small {
    color: var(--color-mustard);
  }

  @media (max-width: 24rem) {
    .brand {
      gap: 0.6rem;
    }

    .brand__mark {
      width: 2.1rem;
      height: 2.1rem;
    }

    .brand strong {
      font-size: 1.1rem;
    }
  }
</style>