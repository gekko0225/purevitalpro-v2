---
import { getCollection } from "astro:content";
import ArticleCard from "./ArticleCard.astro";

const articles = await getCollection(
  "articles",
  ({ data }) => !data.draft && data.featured
);

const featuredArticles = articles
  .sort(
    (a, b) =>
      b.data.publishedAt.getTime() -
      a.data.publishedAt.getTime()
  )
  .slice(0, 3);
---

{
  featuredArticles.length > 0 && (
    <section
      class="featured-articles"
      aria-labelledby="featured-articles-title"
    >
      <div class="featured-articles__container">
        <header class="featured-articles__header">
          <div>
            <p class="featured-articles__eyebrow">
              Biblioteca Vital 40+
            </p>

            <h2 id="featured-articles-title">
              Empieza con estas ideas
            </h2>
          </div>

          <a
            class="featured-articles__all"
            href="/articulos"
          >
            Ver todos los artículos
            <span aria-hidden="true">→</span>
          </a>
        </header>

        <p class="featured-articles__introduction">
          Información práctica y basada en evidencia para ayudarte a
          conservar fuerza, movimiento y vitalidad después de los 40.
        </p>

        <div class="featured-articles__grid">
          {featuredArticles.map((article) => (
            <ArticleCard article={article} />
          ))}
        </div>

        <a
          class="featured-articles__mobile-link"
          href="/articulos"
        >
          Ver todos los artículos
          <span aria-hidden="true">→</span>
        </a>
      </div>
    </section>
  )
}

<style>
  .featured-articles {
    padding-block: clamp(4.5rem, 9vw, 7.5rem);
    background: var(--color-ivory);
  }

  .featured-articles__container {
    width: min(100% - 2rem, 72rem);
    margin-inline: auto;
  }

  .featured-articles__header {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 2rem;
  }

  .featured-articles__eyebrow {
    margin: 0 0 0.75rem;
    color: var(--color-clay);
    font-size: 0.82rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .featured-articles h2 {
    max-width: 14ch;
    margin: 0;
    color: var(--color-ink);
    font-size: clamp(2.1rem, 5vw, 3.75rem);
    line-height: 1.05;
    text-wrap: balance;
  }

  .featured-articles__introduction {
    max-width: 42rem;
    margin: 1.4rem 0 2.5rem;
    color: color-mix(
      in srgb,
      var(--color-ink) 75%,
      transparent
    );
    font-size: 1.05rem;
    line-height: 1.75;
  }

  .featured-articles__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.5rem;
  }

  .featured-articles__all,
  .featured-articles__mobile-link {
    color: var(--color-clay);
    font-weight: 800;
    text-decoration: none;
  }

  .featured-articles__all:hover,
  .featured-articles__mobile-link:hover {
    text-decoration: underline;
    text-underline-offset: 0.3em;
  }

  .featured-articles__mobile-link {
    display: none;
    margin-top: 2rem;
  }

  @media (max-width: 56rem) {
    .featured-articles__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 40rem) {
    .featured-articles__all {
      display: none;
    }

    .featured-articles__mobile-link {
      display: inline-flex;
      gap: 0.5rem;
    }

    .featured-articles__grid {
      grid-template-columns: 1fr;
    }
  }
</style>