---
interface Props {
  reviewedAt?: Date;
}

const { reviewedAt } = Astro.props;

const formattedReviewDate = reviewedAt?.toLocaleDateString("es-CO", {
  month: "long",
  year: "numeric",
});
---

<aside class="author-box" aria-labelledby="author-box-title">
  <div class="author-box__avatar" aria-hidden="true">
    DC
  </div>

  <div class="author-box__content">
    <p class="author-box__eyebrow">
      Autor y editor
    </p>

    <h2 id="author-box-title">
      Darwin Candelo
    </h2>

    <p class="author-box__description">
      Creador de Pure Vital Pro. Investiga y traduce información
      sobre fuerza, movimiento y bienestar en contenidos prácticos
      dirigidos a personas mayores de 40 años.
    </p>

    <p class="author-box__clarification">
      Darwin no se presenta como profesional de la salud. Los
      contenidos son educativos, se apoyan en fuentes identificadas
      y no sustituyen una valoración individual.
    </p>

    {
      reviewedAt && (
        <p class="author-box__review">
          Revisado por última vez en {formattedReviewDate}.
        </p>
      )
    }

    <a href="/criterio-editorial">
      Conoce nuestro criterio editorial
      <span aria-hidden="true">→</span>
    </a>
  </div>
</aside>

<style>
  .author-box {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 1.25rem;
    margin-block: clamp(3rem, 7vw, 5rem);
    padding: clamp(1.5rem, 4vw, 2rem);
    background: color-mix(
      in srgb,
      var(--color-forest) 8%,
      var(--color-ivory)
    );
    border: 1px solid color-mix(
      in srgb,
      var(--color-forest) 22%,
      transparent
    );
    border-radius: 1.25rem;
  }

  .author-box__avatar {
    display: grid;
    place-items: center;
    width: 4rem;
    height: 4rem;
    color: var(--color-ivory);
    background: var(--color-forest);
    border-radius: 50%;
    font-size: 1rem;
    font-weight: 800;
    letter-spacing: 0.05em;
  }

  .author-box__eyebrow {
    margin: 0 0 0.3rem;
    color: var(--color-clay);
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .author-box h2 {
    margin: 0;
    color: var(--color-ink);
    font-size: 1.5rem;
    line-height: 1.2;
  }

  .author-box__description,
  .author-box__clarification {
    margin: 0.8rem 0 0;
    color: color-mix(
      in srgb,
      var(--color-ink) 78%,
      transparent
    );
    font-size: 0.95rem;
    line-height: 1.7;
  }

  .author-box__clarification {
    font-size: 0.88rem;
  }

  .author-box__review {
    margin: 0.8rem 0 0;
    color: var(--color-forest);
    font-size: 0.82rem;
    font-weight: 700;
  }

  .author-box a {
    display: inline-flex;
    gap: 0.45rem;
    margin-top: 1rem;
    color: var(--color-clay);
    font-size: 0.9rem;
    font-weight: 800;
    text-decoration: none;
  }

  .author-box a:hover {
    text-decoration: underline;
    text-underline-offset: 0.3em;
  }

  .author-box a:focus-visible {
    outline: 2px solid var(--color-forest);
    outline-offset: 0.3rem;
    border-radius: 0.15rem;
  }

  @media (max-width: 35rem) {
    .author-box {
      grid-template-columns: 1fr;
    }
  }
</style>